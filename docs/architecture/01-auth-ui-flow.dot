digraph G {graph[rankdir=LR,bgcolor="white",fontname="Arial"];node[shape=box,style="rounded",fontname="Arial",fontsize=10];edge[fontname="Arial",fontsize=9]; user[shape=ellipse,label="Farmer / Technician"]; ui[label="Web / Data Studio / Knowledge Studio / Encyclopedia"]; nginx[label="Nginx reverse proxy"]; id[label="Identity Service\n/auth/login, /auth/me, /authorize"]; users[shape=cylinder,label="user_db.users\nuser_db.farm_access"]; svc[label="Tenant-aware service"]; data[shape=cylinder,label="Authorized farm data"]; user->ui[label="credentials / bearer token"]; ui->nginx; nginx->id[label="/api/identity/*"]; id->users; id->ui[label="token + allowed farms"]; ui->nginx[label="Bearer token + farm_id"]; nginx->svc; svc->id[label="verify/authorize or shared identity context"]; svc->data[label="query only allowed farm"]; data->svc->ui->user;}
