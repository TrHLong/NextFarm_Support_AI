digraph G {graph[rankdir=LR,bgcolor="white",fontname="Arial"];node[shape=box,style="rounded",fontname="Arial",fontsize=10];edge[fontname="Arial",fontsize=9]; tech[shape=ellipse,label="Technician / Knowledge Studio"]; web[shape=ellipse,label="Approved HTTPS source"]; ks[label="Knowledge Service\ningest/crawl/approve/search/query/answer"]; id[label="Identity authorization"]; db[shape=cylinder,label="knowledge_db.sources\ndocuments\ndocument_chunks\narticles/checklists/resolved_cases"]; retr[label="Lexical/vector-like retrieval\nranked chunks + citations"]; chat[shape=ellipse,label="Chatbot / Knowledge Studio answer"]; tech->ks[label="admin actions"]; ks->id; web->ks[label="validated HTTPS ingest"]; ks->db[label="store draft/approved chunks + audit"]; chat->ks[label="query + optional farm_id"]; ks->retr; db->retr; retr->ks[label="evidence + citation + confidence"]; ks->chat;}
