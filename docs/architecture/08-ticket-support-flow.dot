digraph G {graph[rankdir=LR,bgcolor="white",fontname="Arial"];node[shape=box,style="rounded",fontname="Arial",fontsize=10];edge[fontname="Arial",fontsize=9]; farmer[shape=ellipse,label="Farmer"]; chat[label="Chatbot\ncreate_ticket_suggestion"]; confirm[label="POST /tickets/confirm\nexplicit user confirmation"]; ticket[label="Ticket Service"]; id[label="Identity / farm access"]; db[shape=cylinder,label="support_db.tickets\nticket_messages/events/checklists\nresolutions/notifications"]; tech[shape=ellipse,label="Technician / SupportOps"]; farmer->chat[label="issue / alert"]; chat->farmer[label="ticket suggestion"]; farmer->confirm[label="confirm"]; confirm->ticket; ticket->id; ticket->db[label="create/update/resolve"]; db->tech[label="dashboard/list"]; tech->ticket[label="accept/message/status/checklist/resolve"]; ticket->db; db->farmer[label="status + messages + notifications"];}
