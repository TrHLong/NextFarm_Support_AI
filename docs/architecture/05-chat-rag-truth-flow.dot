digraph G {graph[rankdir=LR,bgcolor="white",fontname="Arial"];node[shape=box,style="rounded",fontname="Arial",fontsize=10];edge[fontname="Arial",fontsize=9]; farmer[shape=ellipse,label="Farmer message"]; chat[label="Chatbot Orchestrator\nPOST /chat"]; id[label="Identity + farm authorization"]; planner[label="LLM Gateway /plan\ndeterministic or OpenAI"]; tools[label="Tool layer\nFarm Data | Analytics | Crop Router\nKnowledge/RAG | Ticket suggestion"]; evidence[shape=cylinder,label="Evidence\ntelemetry + model result + citations"]; verbal[label="LLM Gateway /verbalize\noptional grounded rewrite"]; guard[label="Truth Guard /verify\nnumeric/source/confidence/tenant/freshness\nexperimental & high-risk gates"]; history[shape=cylinder,label="support_db.chat_messages\nconversations + verification/audit"]; farmer->chat; chat->id; id->chat; chat->planner[label="message + allowed context"]; planner->chat[label="structured tool plan"]; chat->tools; tools->evidence; evidence->chat; chat->verbal; evidence->verbal; verbal->guard[label="candidate answer"]; evidence->guard; guard->chat[label="allowed/final_answer or abstain"]; chat->history; chat->farmer[label="grounded answer + source/data + optional ticket suggestion"];}
