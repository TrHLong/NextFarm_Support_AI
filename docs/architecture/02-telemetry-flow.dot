digraph G {graph[rankdir=LR,bgcolor="white",fontname="Arial"];node[shape=box,style="rounded",fontname="Arial",fontsize=10];edge[fontname="Arial",fontsize=9]; sim[shape=ellipse,label="Reference-calibrated Simulator"]; nf[shape=ellipse,label="NextFarm production connector"]; mqtt[shape=cylinder,label="Mosquitto\nnextfarm/+/+/+"]; api[label="POST /integrations/nextfarm/ingest\nX-Ingest-Api-Key"]; ing[label="Telemetry Ingestion\nvalidate mapping + provenance + idempotency"]; farm[shape=cylinder,label="farm_db.sensor_readings\ndevice_status\ntelemetry_ingest_events"]; ops[shape=cylinder,label="ops_db.ingest_attempts"]; sim->mqtt[label="QoS 1 telemetry/status"]; nf->mqtt[label="optional MQTT"]; nf->api[label="HTTPS packet_id + nextfarm_api"]; mqtt->ing; api->ing; ing->farm[label="accepted rows"]; ing->ops[label="accepted / duplicate / rejected / error audit"];}
