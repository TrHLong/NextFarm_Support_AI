# NextFarm V10 local/sandbox configuration.
# Chạy scripts\setup_v10_env.cmd để tạo .env với secret ngẫu nhiên. KHÔNG commit/chia sẻ .env.
COMPOSE_PROJECT_NAME=nextfarm_v10_crop_ai
NEXTFARM_PG_VOLUME_NAME=nextfarm_v10_crop_ai_pg
POSTGRES_PASSWORD=replace-with-random-db-password
TOKEN_SECRET=replace-with-a-long-random-value
INTERNAL_SERVICE_KEY=replace-with-a-different-long-random-value
NEXTFARM_TECH_PASSWORD=replace-with-random-technician-password
NEXTFARM_FARMER_PASSWORD=replace-with-random-farmer-password

# LLM. deterministic chạy không cần Internet/API key.
# Để bật OpenAI planner + grounded verbalizer: LLM_PROVIDER=openai và điền OPENAI_API_KEY.
LLM_PROVIDER=deterministic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=20
LLM_ENABLE_VERBALIZER=true
RAG_SIMILARITY_THRESHOLD=0.18
RAG_THRESHOLD_VERSION=v10.1-validation-set

# Production override / origin allowlist. Thay bằng domain thật khi triển khai.
CORS_ALLOW_ORIGINS=http://localhost:8080,http://localhost:8081,http://localhost:8082,http://localhost:8084
MQTT_INGEST_PASSWORD=replace-with-random-mqtt-ingest-password
MQTT_SIMULATOR_PASSWORD=replace-with-random-mqtt-simulator-password
NEXTFARM_INGEST_KEY=replace-with-dedicated-nextfarm-ingest-key
NEXTFARM_HTTP_BIND=127.0.0.1:18080
NEXTFARM_DATA_STUDIO_BIND=127.0.0.1:18081
NEXTFARM_KNOWLEDGE_STUDIO_BIND=127.0.0.1:18082
NEXTFARM_AI_ENCYCLOPEDIA_BIND=127.0.0.1:18084

# Tùy chọn: token Mendeley nếu cần tải lại nguồn bổ sung.
# MENDELEY_ACCESS_TOKEN=
DEVICE_AUTO_TRAIN=false
